# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only, never exposed to the client
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe Connect ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# platform fee, basis points (1500 = 15%). Source of truth is the DB `platform_settings`
# table; this is only the bootstrap default.
PLATFORM_FEE_BPS=1500

# --- Video (LiveKit) ---
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- AI provider (behind lib/ai/provider.ts) ---
AI_PROVIDER=openai
OPENAI_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
